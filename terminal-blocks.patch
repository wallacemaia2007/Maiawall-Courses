@@ -0,0 +1,63 @@
+/**
+ * Converte o `content` de uma aula (string vinda do courses.json / API) em blocos.
+ *
+ * Trechos de código são marcados com cerca de três crases, igual ao Markdown:
+ *
+ *   ```bash
+ *   git init
+ *   ```
+ *
+ * A linha de abertura aceita `linguagem` e, opcionalmente, um título para a janela:
+ *
+ *   ```yaml compose.yaml
+ *
+ * Tudo que estiver fora das cercas continua sendo texto (HTML) como antes, então
+ * conteúdos antigos sem marcação não mudam.
+ */
+
+export type ContentBlock =
+  | { kind: 'text'; html: string }
+  | { kind: 'code'; language: string; title: string; code: string };
+
+/* Abertura e fechamento precisam estar no início da linha. */
+const FENCE = /^```([^\n`]*)\n([\s\S]*?)(?:\n|^)```[ \t]*$/gm;
+
+export function parseLessonContent(content: string | null | undefined): ContentBlock[] {
+  if (!content) return [];
+
+  const source = content.replace(/\r\n/g, '\n');
+  const blocks: ContentBlock[] = [];
+  let cursor = 0;
+
+  const pushText = (raw: string): void => {
+    const html = raw.trim();
+    if (html) blocks.push({ kind: 'text', html });
+  };
+
+  for (const match of source.matchAll(FENCE)) {
+    const start = match.index ?? 0;
+    pushText(source.slice(cursor, start));
+
+    const [language = '', ...titleParts] = match[1].trim().split(/\s+/);
+    blocks.push({
+      kind: 'code',
+      language: language.toLowerCase(),
+      title: titleParts.join(' '),
+      code: match[2].replace(/\s+$/, ''),
+    });
+
+    cursor = start + match[0].length;
+  }
+
+  pushText(source.slice(cursor));
+  return blocks;
+}
+
+/**
+ * Retorna só o primeiro trecho de código de um conteúdo (ou o próprio conteúdo
+ * quando não há cercas). Usado em prévias que mostram código puro.
+ */
+export function extractFirstCode(content: string): string {
+  const first = parseLessonContent(content).find((block) => block.kind === 'code');
+  return first?.kind === 'code' ? first.code : content;
+}
