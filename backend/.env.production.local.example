APP_ENV=production
PORT=3000
FRONTEND_ORIGIN=https://cursos.maiawall.com

# Firebase de producao
FIREBASE_PROJECT_ID=courses-mai
FIREBASE_DATABASE_ID=(default)
GOOGLE_APPLICATION_CREDENTIALS=./courses-mai-firebase-adminsdk-fbsvc-3bc0aa0eee.json

# Gere valores diferentes dos usados em desenvolvimento.
JWT_SECRET=replace-with-a-production-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-production-refresh-token-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
ADMIN_EMAILS=wallacemaia2007@gmail.com

# OAuth em producao usa FRONTEND_ORIGIN + /api/auth/oauth/<provedor>/callback.
# /api e encaminhado pelo Vercel no mesmo host do frontend.
OAUTH_CALLBACK_BASE_URL=https://cursos.maiawall.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
