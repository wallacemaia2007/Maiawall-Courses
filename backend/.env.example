APP_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
JWT_SECRET=replace-with-a-strong-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-token-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Firebase (Cloud Firestore). Preencha o projectId do seu projeto Firebase:
FIREBASE_PROJECT_ID=courses-mai
# Deixe como (default) ou use o id de uma database nomeada.
FIREBASE_DATABASE_ID=(default)

# Credencial: informe UMA das duas formas abaixo.
# 1) Caminho do arquivo JSON da service account do projeto (Google Cloud):
GOOGLE_APPLICATION_CREDENTIALS=
# 2) Conteudo do JSON da service account inline (ex.: Vercel):
#    FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"..."}'
FIREBASE_SERVICE_ACCOUNT=

# Emulador local opcional. Ao instalar o Firebase CLI, rode:
#   firebase emulators:start --only firestore
# e defina:
FIRESTORE_EMULATOR_HOST=
# ex.: localhost:8080

# Login social (GitHub OAuth App + Google OAuth Client).
# OAUTH_CALLBACK_BASE_URL e a URL publica do backend usada para montar o
# redirect_uri exato que voce cadastra nos provedores:
#   GitHub -> ${OAUTH_CALLBACK_BASE_URL}/api/auth/oauth/github/callback
#   Google -> ${OAUTH_CALLBACK_BASE_URL}/api/auth/oauth/google/callback
# Em dev: http://localhost:3000 (o proxy.conf.json do Angular encaminha /api,
# mas o redirect do navegador ao provedor precisa apontar para o backend real).
OAUTH_CALLBACK_BASE_URL=http://localhost:3000

# Deixe os client secrets vazios para desativar um provedor.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=