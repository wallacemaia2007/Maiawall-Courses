APP_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=maiawall_courses
JWT_SECRET=replace-with-a-strong-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-token-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Login social. Deixe as credenciais vazias para desativar um provedor.
OAUTH_REDIRECT_URL=http://localhost:4200/auth/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
