APP_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=maiawall_courses
JWT_SECRET=replace-with-a-strong-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-token-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Login social (GitHub OAuth App + Google OAuth Client).
# OAUTH_CALLBACK_BASE_URL e a URL publica do backend usada para montar o
# redirect_uri exato que voce cadastra nos provedores:
#   GitHub -> ${OAUTH_CALLBACK_BASE_URL}/api/auth/oauth/github/callback
#   Google -> ${OAUTH_CALLBACK_BASE_URL}/api/auth/oauth/google/callback
# Em dev: http://localhost:3000 (o proxy.conf.json do Angular encaminha /api,
# mas o redirect do navegador ao provedor precisa apontar para o backend real).
OAUTH_CALLBACK_BASE_URL=http://localhost:3000

# Deixe os client secrets vazios para desativar um provedor.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=